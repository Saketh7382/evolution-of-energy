{
  "name": "evolution-of-energy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "qa:static": "node scripts/qa-static.mjs",
    "qa:prelaunch": "node scripts/prelaunch-check.mjs",
    "check": "npm run qa:static && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.1.5",
    "drizzle-orm": "0.44.5",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.2",
    "drizzle-kit": "0.31.4"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "packageManager": "npm@10.9.2"
}
